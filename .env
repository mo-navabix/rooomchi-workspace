# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (local Docker: npm run db:up / npm run dev) ---
# Matches docker-compose.yml — user postgres / password postgres / DB didar_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/didar_db

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=didar_db
DATABASE_SSL=false

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=didar_db
DB_SSL=false

