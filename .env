# TypeORM: keep false on hosted DB; use migrations instead of auto-sync
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true

# --- Auth (Nest API; optional — defaults exist in code) ---
JWT_SECRET=didar_enterprise_jwt_super_secret_key_2026
JWT_EXPIRES_IN=7d

# --- Optional (AI Studio / Gemini) ---
GEMINI_API_KEY=
APP_URL=http://localhost:3000
