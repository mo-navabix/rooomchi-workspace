# =============================================================================
# Rooomchi — self-hosted configuration (copy to .env and set strong secrets)
# =============================================================================

# Public URL of the application (used for links, CORS fallback)
APP_URL=http://localhost

# -----------------------------------------------------------------------------
# PostgreSQL (application)
# -----------------------------------------------------------------------------
# Full URL (preferred in Docker / K8s):
# DATABASE_URL=postgresql://rooomchi:CHANGE_ME@postgres:5432/rooomchi_db
DATABASE_URL=

# Or discrete variables (local dev with docker-compose.yml):
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=rooomchi_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# DATABASE_SSL=true

# -----------------------------------------------------------------------------
# PostgreSQL (production Docker Compose — used by postgres service)
# -----------------------------------------------------------------------------
POSTGRES_USER=rooomchi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rooomchi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Required in production (min 32 random characters)
JWT_SECRET=

# Encrypts LDAP/SMTP/OAuth secrets at rest (32+ chars recommended; falls back to JWT_SECRET in dev)
SETUP_ENCRYPTION_KEY=

# Local file uploads (setup wizard + storage integration)
UPLOAD_PATH=./uploads

# Comma-separated allowed origins, or leave empty to use APP_URL in production
CORS_ORIGIN=

# Rate limiting (API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Split deployment (Docker): API only, static served by frontend/nginx
# API_ONLY=true
# SERVE_STATIC=false
# SKIP_SCHEMA_ENSURE=true
# RUN_MIGRATIONS_ON_START=true

# Optional: Gemini AI features
GEMINI_API_KEY=

# Google OAuth (fallback when not set per-organization in DB)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# LDAP (fallback when not set per-organization in DB)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(|(sAMAccountName={username})(userPrincipalName={username})(mail={username}))
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_NAME_ATTRIBUTE=displayName
LDAP_USE_TLS=false

# -----------------------------------------------------------------------------
# Docker Compose production
# -----------------------------------------------------------------------------
ROOOMCHI_HTTP_PORT=80
RUN_MIGRATIONS_ON_START=true

# GHCR production (deployment/docker-compose.prod.ghcr.yml). See docs/GHCR.md
IMAGE_GHCR_BACKEND=ghcr.io/your-github-user/rooomchi-backend:latest
IMAGE_GHCR_FRONTEND=ghcr.io/your-github-user/rooomchi-frontend:latest
# Legacy aliases (optional — compose falls back to these if IMAGE_GHCR_* unset)
# ROOOMCHI_BACKEND_IMAGE=ghcr.io/your-github-user/rooomchi-backend:latest
# ROOOMCHI_FRONTEND_IMAGE=ghcr.io/your-github-user/rooomchi-frontend:latest

# Watchtower (profile watchtower on prod:ghcr:up) — poll interval in seconds
WATCHTOWER_POLL_INTERVAL=86400
# Optional if host `docker login ghcr.io` is not used by the Docker daemon:
# GHCR_USERNAME=
# GHCR_TOKEN=

# -----------------------------------------------------------------------------
# Local dev tools (docker-compose.yml — not used in production stack)
# -----------------------------------------------------------------------------
# ROOOMCHI_PG_PORT=5432
# PGADMIN_DEFAULT_EMAIL=pgadmin@rooomchi.ir
# PGADMIN_DEFAULT_PASSWORD=pgadmin
# ROOOMCHI_PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# SMTP (optional — configure when outbound email is enabled)
# -----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Object storage (optional — for file uploads if enabled)
# -----------------------------------------------------------------------------
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=/data/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
