{
  "name": "rooomchi-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:admin": "docker compose --profile tools up -d postgres pgadmin",
    "db:admin:reset": "docker compose --profile tools rm -sf pgadmin && docker volume rm -f didar_rooomchi_pgadmin_data && docker compose --profile tools up -d postgres pgadmin",
    "db:down": "docker compose --profile tools stop postgres pgadmin",
    "db:logs": "docker compose logs -f postgres",
    "db:admin:logs": "docker compose logs -f pgadmin",
    "db:reset": "docker compose --profile tools down -v && docker compose up -d --wait postgres",
    "db:seed": "tsx scripts/db-cli.ts seed",
    "db:demo-passwords": "tsx scripts/demo-passwords-cli.ts",
    "db:sync": "tsx scripts/db-cli.ts sync",
    "db:schema": "tsx scripts/db-cli.ts schema",
    "db:status": "tsx scripts/db-cli.ts status",
    "db:fix-logo": "tsx scripts/fix-org-logo-column-cli.ts",
    "docs:setup-pdf": "node scripts/build-setup-guide-pdf.mjs",
    "setup:reset": "tsx scripts/reset-installation-cli.ts",
    "migrate": "tsx scripts/migrate-cli.ts",
    "seed": "tsx scripts/seed-cli.ts",
    "build:client": "vite build",
    "prod:up": "docker compose -f deployment/docker-compose.production.yml --env-file .env up -d --build",
    "prod:down": "docker compose -f deployment/docker-compose.production.yml --env-file .env down",
    "prod:logs": "docker compose -f deployment/docker-compose.production.yml --env-file .env logs -f",
    "prod:ghcr:pull": "docker compose -f deployment/docker-compose.ghcr.yml --env-file .env pull",
    "prod:ghcr:up": "docker compose -f deployment/docker-compose.ghcr.yml --env-file .env up -d",
    "prod:ghcr:down": "docker compose -f deployment/docker-compose.ghcr.yml --env-file .env down",
    "prod:ghcr:logs": "docker compose -f deployment/docker-compose.ghcr.yml --env-file .env logs -f",
    "dev": "docker compose up -d --wait postgres && tsx server.ts",
    "dev:app": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "nx": "nx",
    "build:web": "nx build web",
    "build:api": "nx build api",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "release:enterprise": "bash scripts/build-enterprise-release.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/typeorm": "^12.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "ldapts": "^9.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "md-to-pdf": "^5.2.5",
    "nx": "^23.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
