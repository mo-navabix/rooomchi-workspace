# Rooomchi Enterprise — copy to config/.env before install
# Server: docker login ghcr.io -u OWNER -p PAT   (read:packages)

# GHCR Images
IMAGE_GHCR_BACKEND=ghcr.io/OWNER/rooomchi-backend:latest
IMAGE_GHCR_FRONTEND=ghcr.io/OWNER/rooomchi-frontend:latest

# Public URL (HTTPS when using host nginx + certbot on room.acorex.ir)
APP_URL=https://room.acorex.ir
CORS_ORIGIN=https://room.acorex.ir

POSTGRES_USER=rooomchi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rooomchi_db

JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS________________
SETUP_ENCRYPTION_KEY=

# Local bind only (see docker-compose); host nginx proxies to this port
ROOOMCHI_HTTP_PORT=10808
RUN_MIGRATIONS_ON_START=true
LOG_LEVEL=info
RATE_LIMIT_MAX=300

LICENSE_PATH=/app/config/license.json

# Watchtower: only backend + frontend are labeled for updates (postgres/nginx skipped).
# If Watchtower already runs on the host, set WATCHTOWER_LABEL_ENABLE=true there and
# recreate this stack — do not also use --profile watchtower unless you want a second instance.
# Optional registry auth for private image pulls:
# GHCR_USERNAME=
# GHCR_TOKEN=
# WATCHTOWER_POLL_INTERVAL=86400
