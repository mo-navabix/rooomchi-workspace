# Host nginx (outside Docker) — room.acorex.ir → http://127.0.0.1:10808
#
# 1) Copy this file BEFORE you have TLS certs (HTTP only — nginx -t will pass):
#      sudo cp /opt/room.acorex.ir/nginx/host-reverse-proxy.conf.example \
#               /etc/nginx/sites-available/room.acorex.ir
#      sudo ln -sf /etc/nginx/sites-available/room.acorex.ir /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
#
# 2) Issue cert and let certbot add the 443 server block:
#      sudo certbot --nginx -d room.acorex.ir
#
# config/.env: ROOOMCHI_HTTP_PORT=10808, APP_URL=https://room.acorex.ir

server {
    listen 80;
    listen [::]:80;
    server_name room.acorex.ir;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:10808;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
