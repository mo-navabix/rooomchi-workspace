# Copy to config/.env — Rooomchi Enterprise
APP_URL=https://roomchi.example.com
CORS_ORIGIN=https://roomchi.example.com

POSTGRES_USER=rooomchi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rooomchi_db

JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS________________
SETUP_ENCRYPTION_KEY=

ROOOMCHI_HTTP_PORT=80
RUN_MIGRATIONS_ON_START=true
LOG_LEVEL=info

LICENSE_PATH=/app/config/license.json
