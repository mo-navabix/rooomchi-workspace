# Rooomchi Enterprise — copy to config/.env (never commit config/.env)
#
# Use with every Compose command:
#   docker compose --env-file ./config/.env <command>
#
# Domain example: room.acorex.ir

# -----------------------------------------------------------------------------
# Public URL (must match browser origin — scheme + host, no trailing slash)
# -----------------------------------------------------------------------------
APP_URL=https://room.acorex.ir
CORS_ORIGIN=https://room.acorex.ir

# -----------------------------------------------------------------------------
# GHCR images (see docs/GHCR.md — owner must be lowercase GitHub user/org)
# Pin immutable tags in production (Git tag v* or sha-<commit>), not :latest
# -----------------------------------------------------------------------------
IMAGE_GHCR_BACKEND=ghcr.io/mo-navabix/rooomchi-backend:v2.1.0
IMAGE_GHCR_FRONTEND=ghcr.io/mo-navabix/rooomchi-frontend:v2.1.0

# Legacy fallbacks (optional if IMAGE_GHCR_* are set)
# ROOOMCHI_BACKEND_IMAGE=ghcr.io/mo-navabix/rooomchi-backend:latest
# ROOOMCHI_FRONTEND_IMAGE=ghcr.io/mo-navabix/rooomchi-frontend:latest

# -----------------------------------------------------------------------------
# PostgreSQL (embedded service — omit DATABASE_URL to use these)
# -----------------------------------------------------------------------------
POSTGRES_USER=rooomchi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rooomchi_db

# External database (optional — replaces embedded postgres when set)
# DATABASE_URL=postgresql://user:pass@db-host:5432/rooomchi_db
# DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Application secrets
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS________________
SETUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
RUN_MIGRATIONS_ON_START=true
LOG_LEVEL=info
RATE_LIMIT_MAX=300

# Host port mapped to container nginx :80 (use 8080 if host :80 is taken)
ROOOMCHI_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# GHCR pull (server: docker login ghcr.io — PAT needs read:packages)
# Optional — only for Watchtower profile or scripted login helpers
# -----------------------------------------------------------------------------
# GHCR_USERNAME=
# GHCR_TOKEN=

# Watchtower: docker compose --env-file ./config/.env --profile watchtower up -d
# WATCHTOWER_POLL_INTERVAL=86400

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=
